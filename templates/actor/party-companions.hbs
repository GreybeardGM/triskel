<section class="party-companions" aria-label="{{localize "TRISKEL.Item.Category.Companion"}}">
  <h2>{{localize "TRISKEL.Item.Category.Companion"}}</h2>
  {{#if companions.length}}
    <div class="party-roster__member party-roster__member--companion party-roster__columns" aria-hidden="true">
      <span>{{localize "TRISKEL.Misc.Sheet.Name"}}</span>
      <span>{{localize "TRISKEL.Item.Companion.Role"}}</span>
      <span>{{localize "TRISKEL.Item.Companion.Complication"}}</span>
      <span class="party-roster__cost">{{localize "TRISKEL.Item.Companion.Consumption"}}</span>
    </div>
    <ul class="party-roster__members">
      {{#each companions}}
        <li class="party-roster__member party-roster__member--companion" data-item-id="{{id}}">
          <input
            type="checkbox"
            aria-label="{{localize "TRISKEL.Actor.Party.Active" name=name}}"
            {{checked active}}
            {{#unless ../editable}}disabled{{/unless}}
          />
          <span class="party-roster__portrait">
            <button
              type="button"
              data-action="openCompanion"
              aria-label="{{localize "TRISKEL.Misc.Sheet.Open" name=name}}"
            >
              <img src="{{portrait}}" alt="" />
            </button>
          </span>
          <span>
            <button type="button" class="party-roster__open-name" data-action="openCompanion">{{name}}</button>
          </span>
          <span>{{role}}</span>
          <span class="party-companions__complication">{{complication}}</span>
          <span class="party-roster__cost">{{consumption}}</span>
          {{#if ../editable}}
            <button
              type="button"
              class="party-roster__remove"
              data-action="removeCompanion"
              aria-label="{{localize "TRISKEL.Actor.Party.Remove" name=name}}"
              title="{{localize "TRISKEL.Actor.Party.Remove" name=name}}"
            >
              <i class="fa-solid fa-trash" aria-hidden="true"></i>
            </button>
          {{/if}}
        </li>
      {{/each}}
    </ul>
  {{else if editable}}
    <p class="party-roster__hint">{{localize "TRISKEL.Actor.Party.CompanionDropHint"}}</p>
  {{else}}
    <p>{{localize "TRISKEL.Actor.Party.NoCompanions"}}</p>
  {{/if}}
</section>
