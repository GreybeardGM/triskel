<section class="party-roster" aria-label="{{localize "TRISKEL.Actor.Party.Members"}}">
  <p class="party-roster__consumption">
    <strong>{{localize "TRISKEL.Actor.Party.Consumption"}}</strong> {{consumption}}
  </p>
  {{#if members.length}}
    <ul class="party-roster__members">
      {{#each members}}
        <li class="party-roster__member" data-member-key="{{key}}">
          <input
            type="checkbox"
            data-member-active
            aria-label="{{localize "TRISKEL.Actor.Party.Active" name=name}}"
            {{checked active}}
            {{#unless ../editable}}disabled{{/unless}}
          />
          <span class="party-roster__portrait">
            {{#if portrait}}<img src="{{portrait}}" alt="" />{{/if}}
          </span>
          <span class="party-roster__name">{{name}}</span>
          <span class="party-roster__class">{{className}}</span>
          {{#if ../editable}}
            <button
              type="button"
              data-action="removePartyMember"
              aria-label="{{localize "TRISKEL.Actor.Party.Remove" name=name}}"
              title="{{localize "TRISKEL.Actor.Party.Remove" name=name}}"
            >
              <i class="fa-solid fa-trash" aria-hidden="true"></i>
            </button>
          {{/if}}
        </li>
      {{/each}}
    </ul>
  {{/if}}

  {{#if editable}}
    <p class="party-roster__hint">{{localize "TRISKEL.Actor.Party.DropHint"}}</p>
  {{else unless members.length}}
    <p class="party-roster__hint">{{localize "TRISKEL.Actor.Party.Empty"}}</p>
  {{/if}}
</section>
