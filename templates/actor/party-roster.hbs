<section class="party-roster" aria-label="{{localize "TRISKEL.Actor.Party.Members"}}">
  <p class="party-roster__consumption">
    <strong>{{localize "TRISKEL.Actor.Party.Consumption"}}</strong> {{consumption}}
  </p>
  {{#if members.length}}
    <div class="party-roster__member party-roster__columns" aria-hidden="true">
      <span>{{localize "TRISKEL.Misc.Sheet.Name"}}</span>
      <span>{{localize "TRISKEL.Actor.Party.MemberClass"}}</span>
      <span class="party-roster__cost">{{localize "TRISKEL.Item.Companion.Consumption"}}</span>
    </div>
    <ul class="party-roster__members">
      {{#each members}}
        <li class="party-roster__member" data-member-key="{{key}}">
          <input
            type="checkbox"
            data-member-active
            aria-label="{{localize "TRISKEL.Actor.Party.Active" name=name}}"
            {{checked active}}
            {{#unless ../editable}}disabled{{/unless}}
          />
          <span class="party-roster__portrait">
            {{#if portrait}}
              <button
                type="button"
                data-action="openPartyMember"
                aria-label="{{localize "TRISKEL.Misc.Sheet.Open" name=name}}"
              >
                <img src="{{portrait}}" alt="" />
              </button>
            {{/if}}
          </span>
          <span>
            {{#if available}}
              <button type="button" class="party-roster__open-name" data-action="openPartyMember">{{name}}</button>
            {{else}}
              {{name}}
            {{/if}}
          </span>
          <span>{{className}}</span>
          <span class="party-roster__cost">{{../memberConsumption}}</span>
          {{#if ../editable}}
            <button
              type="button"
              class="party-roster__remove"
              data-action="removePartyMember"
              aria-label="{{localize "TRISKEL.Actor.Party.Remove" name=name}}"
              title="{{localize "TRISKEL.Actor.Party.Remove" name=name}}"
            >
              <i class="fa-solid fa-trash" aria-hidden="true"></i>
            </button>
          {{/if}}
        </li>
      {{/each}}
    </ul>
  {{else if editable}}
    <p class="party-roster__hint">{{localize "TRISKEL.Actor.Party.DropHint"}}</p>
  {{else}}
    <p>{{localize "TRISKEL.Actor.Party.Empty"}}</p>
  {{/if}}
</section>
